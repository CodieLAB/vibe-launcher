<?xml version="1.0" encoding="utf-8"?>
<!-- The store build only: the Home button, for a TV whose stock launcher stays on (no adb). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <!-- Every Home app on the TV: HomeKeyService looks up the stock launcher's home screens. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application>
        <!-- The user turns this on under Settings > Accessibility. See HomeKeyService. -->
        <service
            android:name=".HomeKeyService"
            android:label="@string/home_key_name"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>
        <!-- Opened once at boot by HomeKeyService, so the screen behind it says what it is. -->
        <activity
            android:name=".ProbeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
