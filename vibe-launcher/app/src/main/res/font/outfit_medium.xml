<?xml version="1.0" encoding="utf-8"?>
<!-- Outfit at weight 500 for headings. Set here, in a font resource, the weight applies on every Android
     version; android:fontVariationSettings on a view is ignored by Android 9 (the BRAVIAs). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <font
        android:font="@font/outfit"
        android:fontStyle="normal"
        android:fontWeight="500"
        android:fontVariationSettings="'wght' 500"
        tools:targetApi="28" />
</font-family>
