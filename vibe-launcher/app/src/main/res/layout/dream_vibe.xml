<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver: the backdrops from Home cross-fading, with the clock and the film's title. The stills
     are darkened most at the bottom, so both sit there. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Two layers that take turns: the next still fades in on one while the other fades out. -->
    <ImageView
        android:id="@+id/stillA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/stillB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/clockBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="72dp"
        android:layout_marginBottom="64dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFFFF"
                android:textSize="96sp"
                android:fontFamily="@font/outfit"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false"
                android:shadowColor="#80000000"
                android:shadowRadius="18" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="16dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#B3FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@font/outfit"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextClock
            android:id="@+id/dreamDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:format12Hour="EEEE  d MMMM"
            android:format24Hour="EEEE  d MMMM"
            android:textColor="#B3FFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/outfit"
            android:letterSpacing="0.14"
            android:textAllCaps="true" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/titleBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="72dp"
        android:layout_marginBottom="72dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:maxWidth="420dp"
            android:maxHeight="140dp"
            android:adjustViewBounds="true"
            android:scaleType="fitEnd"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:gravity="end"
            android:maxWidth="520dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone"
            android:textColor="#FFFFFFFF"
            android:textSize="40sp"
            android:fontFamily="@font/outfit"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowRadius="14" />
    </FrameLayout>
</FrameLayout>
