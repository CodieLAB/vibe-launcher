<?xml version="1.0" encoding="utf-8"?>
<!-- Vibe Launcher settings: keys for the backdrop sources. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vibe_settings"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500" />

    <TextView
        style="@style/SettingsLabel"
        android:text="@string/tmdb_key" />

    <EditText
        android:id="@+id/tmdbKey"
        style="@style/SettingsField" />

    <TextView
        style="@style/SettingsLabel"
        android:text="@string/plex_token" />

    <EditText
        android:id="@+id/plexToken"
        style="@style/SettingsField"
        android:imeOptions="actionDone|flagNoExtractUi" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cancel"
            style="@style/TopButton"
            android:paddingStart="20dp"
            android:text="@android:string/cancel" />

        <TextView
            android:id="@+id/save"
            style="@style/TopButton"
            android:paddingStart="20dp"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>
